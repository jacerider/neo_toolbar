<?php

/**
 * @file
 * The module's one global function.
 *
 * Every hook this module implements lives on a class under `src/Hook`, and the
 * module declares `neo_toolbar.skip_procedural_hook_scan` so that core's hook
 * collector stops reading this file looking for more. Extension loading is
 * unaffected by that parameter — the module handler includes this file
 * regardless — which is what keeps the function below defined.
 */

/**
 * Generic access callback for the toolbar.
 *
 * The answer, the memo behind it and the collaborators it needs all live on
 * the `neo_toolbar.access_gate` service; see
 * \Drupal\neo_toolbar\ToolbarAccessGate::hasAccess(). This function is kept as
 * a forwarder because it is a global function in a file every site running
 * this module loads, and a site's own code may call it.
 *
 * @return bool
 *   TRUE if the current user has access to the toolbar, FALSE otherwise.
 */
function neo_toolbar_toolbar_view_access(): bool {
  return \Drupal::service('neo_toolbar.access_gate')->hasAccess();
}
