{#
/**
 * @file
 * Default theme implementation to display neo_toolbar_region.
 *
 * Available variables:
 * - foo: Foo variable description.
 *
 * @see template_preprocess_neo_toolbar_region()
 *
 * @ingroup themeable
 */
#}
{%
  set classes = [
    'flex',
    alignment == 'vertical' ? 'flex-col',
    style == 'default' ? 'gap-2',
    style == 'default' and alignment == 'vertical' ? 'px-1 md:px-2',
    style == 'pill' ? 'bg-base-200 p-0.5 md:p-1 gap-0.5 md:gap-1',
    style == 'pill' and alignment == 'horizontal' ? 'rounded-md md:rounded-xl overflow-hidden',
    style == 'pill' and alignment == 'vertical' ? 'mx-2',
    style == 'pill_nested' ? 'bg-primary-500 rounded md:rounded-lg',
    style == 'pill_nested' and alignment == 'horizontal' ? 'items-center justify-center p-0.5 md:p-1',
    style == 'pill_nested' and alignment == 'vertical' ? 'p-1 pt-0',
    style == 'modal' ? 'flex-col gap-2 px-4',
    style == 'grid' ? 'grid grid-cols-2 gap-2 px-2 md:px-3',
  ]
%}
<div{{ attributes.addClass('neo-toolbar--item', classes) }}>
  {% if style == 'pill_nested' and alignment == 'horizontal' %}
    <div class="flex gap-0.5 md:gap-1 h-full rounded md:rounded overflow-hidden">
  {% endif %}

  {% block elements %}
    {{ elements }}
  {% endblock %}

  {% if style == 'pill_nested' and alignment == 'horizontal' %}
    </div>
  {% endif %}
</div>
